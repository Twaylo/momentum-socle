# Réseau des constructions distantes.
#
# Le premier déploiement est tombé sur `socket hang up` pendant le
# `postinstall` d'esbuild — une coupure en récupérant son binaire, pas une
# erreur de configuration. Les valeurs par défaut de npm abandonnent vite : sur
# un réseau de build partagé, ça suffit à faire échouer une mise en ligne pour
# une raison qui n'a rien à voir avec le code.
#
# Ces réglages ne changent rien en local, où le réseau tient.
fetch-retries=5
fetch-retry-factor=2
fetch-retry-mintimeout=10000
fetch-retry-maxtimeout=120000
fetch-timeout=300000

# Le rapport d'audit et les messages de financement n'ont rien à faire dans un
# journal de déploiement qu'on lit en cherchant une erreur.
audit=false
fund=false

# ⚠ La construction distante emploie `npm install`, pas `npm ci`.
#
# Ce n'est pas un relâchement : `npm ci` commence par SUPPRIMER node_modules
# entier, et l'hébergeur y monte un cache de construction sur
# `node_modules/.cache`. Un répertoire monté ne se supprime pas — la
# construction tombait sur `EBUSY: resource busy or locked`.
#
# `npm install` respecte le même package-lock.json et installe les mêmes
# versions. Ce qu'on perd, c'est le refus de `npm ci` quand le verrou et le
# manifeste divergent — garantie qui reste tenue ici, puisque les tests
# tournent sur ce verrou avant chaque envoi.
package-lock=true
