{
  "name": "momentum",
  "private": true,
  "version": "3.0.0",
  "type": "module",
  "description": "Momentum — publication et analyse multi-réseaux pour créateurs de contenu",
  "engines": {
    "node": ">=22.11"
  },
  "scripts": {
    "dev": "concurrently -n web,api -c cyan,magenta \"npm:dev:web\" \"npm:dev:api\"",
    "dev:web": "vite",
    "dev:api": "node --watch --watch-path=server --env-file-if-exists=.env server/index.js",
    "build": "tsc -b && vite build",
    "start": "node server/index.js",
    "test": "node --test \"noyau/**/*.test.js\" \"src/**/*.test.js\" \"server/**/*.test.js\"",
    "lint": "eslint . && tsc -b",
    "migrate": "node server/db/migrer.js"
  },
  "dependencies": {
    "cookie-parser": "^1.4.7",
    "express": "^4.22.2",
    "pg": "^8.22.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^26.2.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.2.3",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "globals": "^15.14.0",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.19.0",
    "vite": "^6.0.3"
  }
}
