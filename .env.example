# ============================================================================
# Momentum — variables d'environnement
# ----------------------------------------------------------------------------
# EXG-TEC-041 (B) : « Aucun secret ne doit figurer dans le dépôt. Un fichier
# d'exemple doit documenter toutes les variables attendues — une variable non
# documentée est une fonctionnalité que personne ne peut activer. »
#
# Copier en `.env` et remplir. `.env` est ignoré par git.
# ============================================================================

# ─── Serveur ─────────────────────────────────────────────────────────────────
# Port de l'API en développement. En production, l'hébergeur impose PORT.
API_PORT=8787

# Origine publique de l'application. Sert au redirect_uri OAuth et au drapeau
# Secure du cookie de session.
APP_ORIGIN=http://localhost:5173

# Adresse publique du SERVEUR. Ne pas renseigner sur Railway ni Render : elle est
# déduite de RAILWAY_PUBLIC_DOMAIN / RENDER_EXTERNAL_URL, ce qui supprime une
# recopie à la main et la faute de frappe qui va avec.
#
# ⚠ C'est elle qui construit l'adresse de retour OAuth :
#     <URL_PUBLIQUE>/api/connexions/retour/<reseau>
#   Cette adresse doit être déclarée À L'IDENTIQUE dans la console de chaque
#   plateforme. Les plateformes la comparent CARACTÈRE PAR CARACTÈRE : un `http`
#   au lieu d'un `https`, une barre finale en trop, et l'échange échoue sur
#   « redirect_uri_mismatch » — un message qui ne dit pas laquelle des deux est
#   fausse.
URL_PUBLIQUE=


# ─── Bac à sable (EXG-TEC-012) ───────────────────────────────────────────────
# « Un mode bac à sable complet doit permettre de dérouler tout le produit sans
# rien publier réellement, y compris en préproduction. »
#
# Non renseigné : ACTIF partout sauf en production. Le défaut sûr est l'inverse
# de celui qu'on choisirait par confort — une variable oubliée doit empêcher une
# publication réelle, jamais l'autoriser par accident.
PUBLISHER_SANDBOX=true


# ─── Backend de publication, PAR RÉSEAU (DEC-003, EXG-TEC-010/011) ───────────
# Une variable par réseau, jamais un drapeau global : les validations
# plateformes tombent une par une (ch. 6.1), et un drapeau global obligerait à
# attendre la dernière pour bénéficier de la première.
#
# Valeurs : `aggregator` (défaut) ou `direct`.
# Le basculement se fait par redémarrage, sans redéploiement de code applicatif.
PUBLISHER_YOUTUBE=aggregator
PUBLISHER_TIKTOK=aggregator
PUBLISHER_INSTAGRAM=aggregator
PUBLISHER_FACEBOOK=aggregator
PUBLISHER_X=aggregator
PUBLISHER_LINKEDIN=aggregator
# Bluesky n'exige aucune validation : publiable nativement dès le premier jour.
PUBLISHER_BLUESKY=direct


# ─── Agrégateur ──────────────────────────────────────────────────────────────
# ⚠ Avant de souscrire : VÉRIFIER LE MODE DE FACTURATION (ch. 48, risque n° 1).
#   Si la facturation est par profil créateur et non par compte, chaque abonné
#   consomme un profil et un plan à 40 €/mois devient déficitaire.
#   Annexe C : à trancher par le fondateur AVANT le lot L1.
AGREGATEUR_CLE=

# URL de base. Ne pas renseigner en temps normal : la valeur par défaut est la
# bonne. Ce réglage existe pour pointer un bac à sable ou un serveur de reprise.
AGREGATEUR_URL=

# ─── Offre multi-comptes (facultative, engagement d'argent) ──────────────────
# ABSENTE = un seul jeu de comptes, relié hors de Momentum. Suffisant tant que
# le fondateur est seul utilisateur ; PLUS suffisant au premier client payant,
# car les comptes seraient partagés entre tous. Voir DEC-021.
#
# AGREGATEUR_PROFIL     : clé du profil client au nom duquel Momentum agit.
# AGREGATEUR_DOMAINE +
# AGREGATEUR_CLE_PRIVEE : permettent de générer une page de liaison signée,
#                         présentable sous notre marque — c'est ce qui rend
#                         EXG-CNX-004 tenable en production.
AGREGATEUR_PROFIL=
AGREGATEUR_DOMAINE=
AGREGATEUR_CLE_PRIVEE=

# ─── Passerelle de LECTURE (facultative, DEC-030) ────────────────────────────
# ⚠ Publier et lire les statistiques sont deux capacités DIFFÉRENTES. Une
#   passerelle peut être excellente pour l'une et ne pas faire l'autre du tout —
#   c'est arrivé, et les chiffres ont disparu en silence.
#
# ABSENTE : les chiffres se lisent chez la passerelle qui publie (comportement
#   d'origine, inchangé).
# RENSEIGNÉE : ils se lisent AILLEURS, sans déplacer les envois. C'est ce qui
#   permet de récupérer les statistiques sans casser ce qui fonctionne déjà.
#
# ⚠ Cette passerelle a ses PROPRES identifiants et ses propres comptes reliés :
#   les réseaux doivent être connectés chez elle aussi, sinon elle n'a rien à
#   lire. Sa clef se met dans INSIGHTS_AGREGATEUR_CLE.
INSIGHTS_AGREGATEUR=
INSIGHTS_AGREGATEUR_CLE=


# ─── Moteur de LECTURE des chiffres, par réseau (DEC-030) ────────────────────
# « Publier » et « lire les stats » sont deux chemins séparés : une passerelle
# peut être bonne pour l'un sans faire l'autre. C'est arrivé, et les chiffres ont
# disparu en silence le jour où l'on a changé de passerelle.
#
# Valeurs : `direct` (chez la plateforme), `aggregator`, ou `none`.
#
# ⚠ Le défaut est `none`, PAS `aggregator`. Un réseau qu'on ne sait pas lire
#   affiche « analytics à activer », jamais un zéro. YouTube fait exception : il
#   est en `direct` par défaut, ses chiffres venant de Google.
INSIGHTS_YOUTUBE=direct
INSIGHTS_TIKTOK=none
INSIGHTS_INSTAGRAM=none
INSIGHTS_FACEBOOK=none
INSIGHTS_X=none
INSIGHTS_LINKEDIN=none


# ─── Identifiants développeur, pour les backends `direct` ────────────────────
# Ne remplir un couple que lorsque la validation de la plateforme est obtenue
# (ch. 6.1). Un scope demandé sans validation casse l'OAuth de lecture.

# YouTube — accessible via Google, aucune validation supplémentaire (§6.1).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# TikTok — ⚠ client_KEY, pas client_id (ch. 28.3). Audit Content Posting API
# requis avant d'obtenir la portée de publication (annexe A.1).
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# Meta — Instagram et Facebook partagent un seul dossier de revue (§6.1), mais
# PAS leurs identifiants d'application.
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# X — OAuth 2.0 avec PKCE. Facturation à l'usage : ~0,015 $ par publication,
# ~0,20 $ si elle contient un lien (§6.1). Plafond de dépense à configurer côté
# plateforme (annexe A.3).
X_CLIENT_ID=
X_CLIENT_SECRET=

# LinkedIn — programme partenaire (Community Management API) : un dossier, pas
# un simple formulaire (§6.1).
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=


# ─── Base de données (DEC-012) ───────────────────────────────────────────────
# Absente : SQLite local dans .donnees/ — un clone suivi de `npm run dev` donne
# un produit qui tourne, sans installer de serveur de base.
# Renseignée : PostgreSQL (production).
DATABASE_URL=

# Clé de chiffrement des jetons OAuth au repos (EXG-TEC-040), 32 octets en hex.
# Générer avec : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ⚠ Sans clé STABLE entre deux déploiements, tous les créateurs devraient
#   reconnecter leurs réseaux à chaque redémarrage.
CLE_CHIFFREMENT=


# ─── Modèle de langage (ch. 32) ──────────────────────────────────────────────
ANTHROPIC_API_KEY=

# EXG-TEC-052 : « Le nombre d'images extraites d'une vidéo pour une analyse doit
# être un paramètre de configuration, pas une constante dans le code. » C'est le
# paramètre qui fait varier le coût d'une analyse d'un facteur dix.
IA_IMAGES_PAR_VIDEO=12

# EXG-TEC-053 : plafond de dépense mensuelle, par compte et global, en euros.
# Alerte avant blocage.
IA_PLAFOND_COMPTE_EUR=15
IA_PLAFOND_GLOBAL_EUR=400


# ─── Espace fondateur (EXG-ADM-001, DEC-008) ─────────────────────────────────
# Comptes autorisés sur /direction, séparés par des virgules.
# ABSENT = personne n'est administrateur. Défaut fermé, volontairement.
COMPTES_FONDATEUR=
